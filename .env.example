# Server-side only. NEVER commit a real key to GitHub.
GEMINI_API_KEY=replace_with_your_gemini_key
# Primary + automatic fallbacks. All are stable model IDs.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash
# Optional: if GEMINI_MODELS is omitted, GEMINI_MODEL becomes the primary.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RETRIES=2
GEMINI_RETRY_BASE_MS=800
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
GITHUB_USERNAME=Souvik-Pramanik
